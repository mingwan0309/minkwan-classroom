{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{8,20}$/)",
        ".validate": "newData.hasChildren(['n', 'x', 'z', 'y', 's', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "x": { ".validate": "newData.isNumber() && newData.val() >= -8 && newData.val() <= 8" },
        "z": { ".validate": "newData.isNumber() && newData.val() >= -11 && newData.val() <= 11" },
        "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7" },
        "s": { ".validate": "newData.isBoolean()" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
