{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{8,20}$/)",
        ".validate": "newData.hasChildren(['n', 'x', 'z', 'y', 's', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "x": { ".validate": "newData.isNumber() && newData.val() >= -8 && newData.val() <= 8" },
        "z": { ".validate": "newData.isNumber() && newData.val() >= -11 && newData.val() <= 11" },
        "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7" },
        "s": { ".validate": "newData.isBoolean()" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "events": {
      ".read": true,
      ".indexOn": ["t"],
      "$e": {
        ".write": true,
        ".validate": "newData.hasChildren(['o', 'k', 'by', 't'])",
        "o": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 200" },
        "k": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "n": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "t": { ".validate": "newData.val() === now" },
        "p": { "$k": { ".validate": "newData.isNumber() && newData.val() > -100 && newData.val() < 100" } },
        "d": { "$k": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1" } },
        "$other": { ".validate": false }
      }
    },
    "state": {
      ".read": true,
      "$c": {
        ".write": "$c.matches(/^[0-9]{1,12}$/)",
        "$i": {
          ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['x', 'y', 'z', 'qx', 'qy', 'qz', 'qw'])",
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "z": { ".validate": "newData.isNumber()" },
          "qx": { ".validate": "newData.isNumber()" },
          "qy": { ".validate": "newData.isNumber()" },
          "qz": { ".validate": "newData.isNumber()" },
          "qw": { ".validate": "newData.isNumber()" },
          "g": { ".validate": "newData.isBoolean()" },
          "sp": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
